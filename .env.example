# Configuración del frontend XEYE. Copia este fichero a `.env` y ajústalo.
# Al ser una SPA, estas URL las usa el NAVEGADOR: deben ser alcanzables desde él.

# --- Servicios ---
# URL base del backend XEYE (auth, listas, elementos, api keys, entrenamientos).
NUXT_PUBLIC_BACKEND_URL=http://localhost:8000
# URL base del microservicio de búsqueda. Las búsquedas van DIRECTAS aquí
# (POST /api/v1/search con cabecera X-API-Key), nunca a través del backend.
NUXT_PUBLIC_SEARCH_URL=http://localhost:8002

# --- Servidor Nitro (solo build de producción / contenedor) ---
# Puerto y host de escucha del servidor que sirve la SPA (en dev manda devServer.port).
#NITRO_PORT=3000
#NITRO_HOST=0.0.0.0
