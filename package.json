{
  "name": "xeye-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "XEYE console — Nuxt 3 frontend for the XEYE backend and search microservice",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@pinia/nuxt": "^0.9.0",
    "@sentry/vue": "^11.0.0",
    "nuxt-security": "^2.6.0",
    "pinia": "^2.3.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/test-utils": "^3.23.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/qrcode": "^1.5.6",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.14.5",
    "nuxt": "^3.21.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.3.6",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.0"
  },
  "comment": "Vite is pinned to v6: Nuxt 3.21's dev server (resolveServerEntry) is not compatible with Vite 7/8. The overrides force every transitive dep onto the same Vite 6.",
  "overrides": {
    "vite": "^6.3.6"
  },
  "pnpm": {
    "overrides": {
      "vite": "^6.3.6"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "@parcel/watcher",
      "vue-demi"
    ]
  }
}
