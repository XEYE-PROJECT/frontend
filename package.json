{
  "name": "xeye-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "XEYE console — Nuxt 3 frontend for the XEYE backend and search microservice",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@pinia/nuxt": "^0.9.0",
    "pinia": "^2.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "nuxt": "^3.21.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.3.6",
    "vue-tsc": "^2.2.0"
  },
  "comment": "Vite is pinned to v6: Nuxt 3.21's dev server (resolveServerEntry) is not compatible with Vite 7/8. The overrides force every transitive dep onto the same Vite 6.",
  "overrides": {
    "vite": "^6.3.6"
  },
  "pnpm": {
    "overrides": {
      "vite": "^6.3.6"
    },
    "onlyBuiltDependencies": ["esbuild", "@parcel/watcher", "vue-demi"]
  }
}
